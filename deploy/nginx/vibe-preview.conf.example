# 局部 WebSocket 头映射（vite HMR / Socket.IO 升级用）— 用独特变量名，避免跟其他配置冲突
map $http_upgrade $vibe_conn_upgrade {
    default upgrade;
    ''      close;
}

# Vibe Coding sandbox 预览反代
# ---------------------------------------------------------------------
# 用 server_name 正则从 host 头解析出 podman 自动分配的 host 端口，
# proxy_pass 转发到 127.0.0.1:<port>。这样浏览器只走 443，避免 mixed
# content；不用每个 sandbox 单独申请证书 / 配端口。
#
# 部署：
#   1. 复制本文件到 /etc/nginx/conf.d/vibe-preview.conf（去掉 .example）
#   2. nginx -t && systemctl reload nginx
#
# 前提：
#   - DNS *.dfy.definesys.cn 通配解析到本机 ECS
#   - SSL 通配证书 *.dfy.definesys.cn 已就位（跟 agent.dfy.definesys.cn 共用）
#   - 前端 build 时设了 VITE_SANDBOX_PREVIEW_BASE=.dfy.definesys.cn
#
# 子域名格式：p<host_port>.dfy.definesys.cn
#   例：podman 把容器内 6173 映射到 host 38451 → 浏览器请求 https://p38451.dfy.definesys.cn/
#       nginx 解析 host 头中的 38451，proxy_pass http://127.0.0.1:38451
#
# 安全：
#   - server_name 正则限制端口区间 30000-65999（podman 默认随机分配段），避免被滥用扫端口
#   - 证书私钥 + ECS 安全组保护底层服务，外部只能通过 nginx 进
#   - 同租户的 workspace 共享 podman 端口池 — 单租户场景可接受；
#     多租户隔离需要 cookie auth / 短期 token，本配置暂不做

server {
    listen 443 ssl http2;
    server_name ~^p(?<vibe_port>\d+)\.dfy\.definesys\.cn$;

    # 复用 *.dfy.definesys.cn 通配证书（跟 agent.dfy.definesys.cn 共用）
    ssl_certificate     /etc/nginx/ssl/agent.dfy.definesys.cn/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/agent.dfy.definesys.cn/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 端口区间校验：只接 30000-65999（podman 默认随机分配段）
    # 落在区间外直接 403，避免被滥用做端口扫描
    set $valid 0;
    if ($vibe_port ~ "^([3-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$") {
        set $valid 1;
    }
    if ($valid = 0) {
        return 403 "vibe-preview: port out of range\n";
    }

    location / {
        proxy_pass http://127.0.0.1:$vibe_port;
        proxy_http_version 1.1;

        # 标准转发头
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 支持（vite HMR / Socket.IO 等）
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $vibe_conn_upgrade;

        # 长连接 + 流式（SSE）
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering    off;
        proxy_cache        off;

        # 大请求体（agent 可能上传文件等）
        client_max_body_size 50m;
    }

    # 上游不可达时的友好提示（podman 容器没起 / 端口已释放）
    error_page 502 503 504 /__vibe_preview_unavailable;
    location = /__vibe_preview_unavailable {
        internal;
        default_type text/plain;
        return 502 "vibe-preview: 沙箱端口 $vibe_port 暂不可达 — 容器是否在跑？\n";
    }
}

