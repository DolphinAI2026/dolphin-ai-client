# Dev deployment environment.
# Keep aPaaS base binding here; deploy scripts inject it into the K8s Secret.

APAAS_BASE_URL=https://apaas-trial.definesys.cn/backend
AUTH_PROVIDER=control_plane
# 可选项：开启后强制完成 aPaaS 与 Control Plane 账号/租户绑定。
CONTROL_PLANE_BINDING_ENABLED=false
# 可选项：Control Plane 登录页所在环境的根地址。
DOLPHIN_WORKSPACE_BASE_URL=https://om-demo.dfy.definesys.cn
# 按实际部署填写 Control Plane API 地址。
DOLPHIN_CODE_CONTROL_PLANE_URL=https://om-demo.dfy.definesys.cn/control-plane
# 测试环境公网 L7 会缓冲过小的 SSE 首包；生产按现场链路决定，默认值仍为 0。
BUILDER_SSE_PADDING_BYTES=16384
APAAS_BACKEND_JDK_VERSION=17

DEV_DATABASE_NAME=apaas_builder_dev
DEV_HOST=agent.dfy.definesys.cn
PUBLIC_URL=https://agent.dfy.definesys.cn/ai-builder/login
# 必配: aPaaS 密码加密密钥(openssl rand -base64 32); 不配后端拒绝启动
ENCRYPTION_KEY=__GENERATE__

# 可选：系统助手的部署级 Git 默认连接。任何未单独配置的租户都会使用它。
SYSTEM_GIT_DEFAULT_PROVIDER=gitlab
# 华宝集群内置 GitLab 的公开地址与默认命名空间；令牌仅由 K8s Secret / CI 注入，禁止提交。
SYSTEM_GIT_DEFAULT_HOST=https://test-ht-agents-gitlab.hijackery.cn
SYSTEM_GIT_DEFAULT_ACCESS_TOKEN=
SYSTEM_GIT_DEFAULT_GROUP_OR_ORG=dolphin-code
