# docker-compose / podman-compose 的变量文件示例
# 用法：cp compose.env.example .env  然后在 deploy/docker/ 下跑 compose

# ============================================================
# 场景 A：主机独占（生产最终形态）
# ============================================================
#VITE_BASE_URL=/ai-builder/
#PORT=8003
#CODE_SERVER_PORT=8080
#IMAGE_TAG=latest
#CONTAINER_NAME=apaas-builder
#WORKSPACES_DIR=/data/apaas/workspaces
#BACKEND_ENV_FILE=/data/apaas/backend.env

# ============================================================
# 场景 B：与线上主机裸跑并存（过渡期，避开 8003/8080/8081）
# ============================================================
VITE_BASE_URL=/ai-builder-docker/
PORT=8103
CODE_SERVER_PORT=8090
IMAGE_TAG=docker
CONTAINER_NAME=apaas-builder-docker
WORKSPACES_DIR=/data/apaas-docker/workspaces
BACKEND_ENV_FILE=/data/apaas-docker/backend.env
