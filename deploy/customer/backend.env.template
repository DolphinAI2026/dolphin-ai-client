# ============================================================
# apaas-builder 客户部署 — 后端业务环境变量模板
# ============================================================
# deploy.sh 会基于本模板生成真正的 backend.env：
#   - 标 __GENERATE__ / __GENERATE_FERNET__ 的密钥由脚本用 openssl 随机生成（绝不用默认值）
#   - 标 __SET_ME__ 的必须由你手工填成客户真实值，否则脚本拒绝部署
#   - 已有 backend.env 时脚本不覆盖（避免重置密钥导致已加密数据无法解密）
# 生成后的 backend.env 权限 600，且被 .gitignore/.dockerignore 排除，绝不入库/入镜像。
# 变量含义详见 docs/deploy-readiness-2026-05-30/05-deployment-inventory.md §2。

# ── 必填：数据库（外置 PostgreSQL，客户预建空库 + 账号）─────────
# 例：postgresql+asyncpg://apaas:<强随机口令>@10.0.0.5:5432/apaas_builder
DATABASE_URL=__SET_ME__

# ── 认证来源（固定一种；不在登录页暴露切换）────────────────────
# apaas=aPaaS；control_plane=Control Plane。local 仅保留旧部署兼容。
AUTH_PROVIDER=control_plane
# 可选项：默认关闭；开启后登录必须完成 aPaaS 与 Control Plane 绑定。
CONTROL_PLANE_BINDING_ENABLED=false
# 可选项：Dolphin 登录和 Token 刷新地址；默认值显式保留，便于部署审计。
DOLPHIN_WORKSPACE_BASE_URL=https://dolphin.dfy.definesys.cn

# ── 客户自己的 aPaaS 平台（AUTH_PROVIDER=apaas 时必填）──────────
APAAS_BASE_URL=

# ── 部署入口配置（客户只维护本文件）──────────────────────────
# 镜像 tag；离线交付时可填 IMAGE_TAR=/path/apaas-builder.tar。
IMAGE_TAG=latest
IMAGE_TAR=
CONTAINER_NAME=apaas-builder

# 服务端口与访问前缀。
PORT=8003
VITE_BASE_URL=/ai-builder/

# 工作区持久化目录。APAAS_WORKSPACE_ROOT 默认跟 WORKSPACES_DIR 一致。
WORKSPACES_DIR=/data/apaas/workspaces
APAAS_WORKSPACE_ROOT=/data/apaas/workspaces

# ── 自动生成密钥（脚本随机化，切勿手填弱值/默认值）──────────────
# JWT 签发；缺则启动崩。泄漏=可伪造任意用户 token（见安全报告 C-3）。
JWT_SECRET_KEY=__GENERATE__
# 落库口令加密（aPaaS/DB/LLM 凭据）。用默认值=拖库即明文（见安全报告 C-2）。
ENCRYPTION_KEY=__GENERATE__
# 第二把 Fernet（加密 git 连接 token），与 ENCRYPTION_KEY 独立（见安全报告 H-8）。
BUILDER_FERNET_KEY=__GENERATE_FERNET__

# ── aPaaS 后端打包环境 ─────────────────────────────────────
# 单个部署环境只服务一种 aPaaS 后端包，默认用 JDK 17；可选：8 / 17 / auto。
APAAS_BACKEND_JDK_VERSION=17

# ── Dolphin Code 集成（启用 Code 菜单时配置）────────────────
# Control Plane API 地址。control_plane 模式下必填。
DOLPHIN_CODE_CONTROL_PLANE_URL=__SET_ME__
# 可选项：仅供无用户上下文的内部任务使用，正常用户请求转发 Dolphin Bearer Token。
DOLPHIN_CODE_CONTROL_PLANE_TOKEN=
# 可选项：本地 runtime fallback 地址。
DOLPHIN_CODE_BUILDER_URL=
# 可选项：默认 seed project。
DOLPHIN_CODE_DEFAULT_SEED_PROJECT_ID=1781233861147
# Builder SSE 首包填充。默认 0；客户公网 L7 会缓冲小响应时可设为 16384。
# 仅影响 /api/builder/events，取值范围 0-65536。
BUILDER_SSE_PADDING_BYTES=0

# Control Plane 自身还必须配置以下环境变量，才能验证上述 Dolphin 签发的 Token：
# CONTROL_PLANE_AUTH_FULL_WORKSPACE_BASE_URL=https://dolphin.dfy.definesys.cn
