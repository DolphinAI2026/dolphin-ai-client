# ============================================================
# apaas-builder 客户部署 — 后端业务环境变量模板
# ============================================================
# deploy.sh 会基于本模板生成真正的 backend.env：
#   - 标 __GENERATE__ / __GENERATE_FERNET__ 的密钥由脚本用 openssl 随机生成（绝不用默认值）
#   - 标 __SET_ME__ 的必须由你手工填成客户真实值，否则脚本拒绝部署
#   - 已有 backend.env 时脚本不覆盖（避免重置密钥导致已加密数据无法解密）
# 生成后的 backend.env 权限 600，且被 .gitignore/.dockerignore 排除，绝不入库/入镜像。
# 变量含义详见 docs/deploy-readiness-2026-05-30/05-deployment-inventory.md §2。

# ── 必填：数据库（外置 MySQL，客户预建空库 + 账号）──────────────
# 例：mysql+aiomysql://apaas:<强随机口令>@10.0.0.5:3306/apaas_builder?charset=utf8mb4
DATABASE_URL=__SET_ME__

# ── 必填：客户自己的 aPaaS 平台（覆盖得帆 POC 默认值）─────────────
APAAS_BASE_URL=__SET_ME__

# ── 必填：LLM 网关（OpenAI/Anthropic 兼容）──────────────────────
# 缺 LLM_API_KEY 后端启动直接崩。ANTHROPIC_* 是运行时实际调用的网关。
LLM_API_KEY=__SET_ME__
ANTHROPIC_BASE_URL=__SET_ME__
ANTHROPIC_API_KEY=__SET_ME__
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_MODEL=claude-haiku-4-5-20251001

# ── 自动生成密钥（脚本随机化，切勿手填弱值/默认值）──────────────
# JWT 签发；缺则启动崩。泄漏=可伪造任意用户 token（见安全报告 C-3）。
JWT_SECRET_KEY=__GENERATE__
# 落库口令加密（aPaaS/DB/LLM 凭据）。用默认值=拖库即明文（见安全报告 C-2）。
ENCRYPTION_KEY=__GENERATE__
# 第二把 Fernet（加密 git 连接 token），与 ENCRYPTION_KEY 独立（见安全报告 H-8）。
BUILDER_FERNET_KEY=__GENERATE_FERNET__
# MCP 客户端鉴权 key（dolphin/外部 agent 调工具用）；留空则 /api/mcp 拒绝外部调用。
MCP_API_KEYS=__GENERATE__

# ── 安全默认（客户不用 Vibe Coding / Web IDE 时保持如下）────────
# host = 不起沙箱子容器，可去掉 docker.sock 挂载（见安全报告 H-4）。
VIBE_CODING_RUNTIME=host
# 留空 = 禁用浏览器内 Web IDE（--auth none 公网暴露 = RCE，见安全报告 H-5）。
CODE_SERVER_BASE_URL=
# 生产建议 false（资源编码不加随机后缀）。
ENABLE_CODE_SUFFIX=false

# ── 进程级变量（compose 会注入，这里留空即可，勿改）──────────────
# APAAS_WORKSPACE_ROOT 由 compose 注入 = WORKSPACES_DIR；PORT 由 compose 注入。

# ── 可选集成（不用就留空，不影响核心搭建链路）──────────────────
# Dolphin omnigate 当作 LLM provider：
DOLPHIN_BASE_URL=
DOLPHIN_API_KEY=
DOLPHIN_MODEL=
# Git 集成（GitHub/GitLab OAuth）：
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# 对外公网地址（给 MCP 客户端下发 deeplink / git OAuth 回调）：
BUILDER_PUBLIC_URL=
