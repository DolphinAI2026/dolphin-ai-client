# aPaaS Platform
APAAS_BASE_URL=https://apaas-trial.definesys.cn/backend

# Database (MySQL)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/apaas_builder

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
# aPaaS 密码加密密钥(必配, openssl rand -base64 32); 本地要沿用仓库默认值需另设 ALLOW_DEFAULT_ENCRYPTION_KEY=1
ENCRYPTION_KEY=__GENERATE__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# ACCEPTED_TOKEN_ISSUERS=ai-builder,desktop-sidecar  # 仅桌面 sidecar 设置; 共享后端留默认 ai-builder

# Server
HOST=0.0.0.0
PORT=8000

# aPaaS 后端打包 JDK 版本：8 / 17 / auto
APAAS_BACKEND_JDK_VERSION=17
