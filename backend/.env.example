# aPaaS Platform
# AUTH_PROVIDER:
#   local  = only ai-builder local accounts
#   apaas  = only aPaaS login, no local fallback
#   control_plane = Dolphin 大平台登录，使用其 Token 访问 Control Plane
# Empty keeps legacy behavior: try aPaaS when configured, then local fallback.
AUTH_PROVIDER=apaas
# 可选项：是否强制 Dolphin 账号已在平台管理绑定本地租户和 aPaaS 环境。
# 默认 false；关闭时按 Dolphin 当前租户自动建立本地上下文。
CONTROL_PLANE_BINDING_ENABLED=false
# 可选项：Dolphin 大平台认证地址；不配置时默认 https://dolphin.dfy.definesys.cn
# DOLPHIN_WORKSPACE_BASE_URL=https://dolphin.dfy.definesys.cn
APAAS_BASE_URL=https://apaas-trial.definesys.cn/backend
# 本地初始化 default 租户时用于绑定 aPaaS 平台租户；不配置则需要在租户管理里手动绑定。
APAAS_TENANT_ID=__SET_ME__
# 本地开发可选：填 token 可直接连通；或填账号密码，应用列表查询时会自动登录换 token。
# APAAS_TOKEN=__LOCAL_XDAPTOKEN__
# APAAS_USERNAME=__LOCAL_APAAS_ACCOUNT__
# APAAS_PASSWORD=__LOCAL_APAAS_PASSWORD__

# Database (MySQL)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/apaas_builder

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
# aPaaS 密码加密密钥(必配, openssl rand -base64 32); 本地要沿用仓库默认值需另设 ALLOW_DEFAULT_ENCRYPTION_KEY=1
ENCRYPTION_KEY=__GENERATE__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# ACCEPTED_TOKEN_ISSUERS=ai-builder,desktop-sidecar  # 仅桌面 sidecar 设置; 共享后端留默认 ai-builder

# Server
HOST=0.0.0.0
PORT=8000

# Skill library
# Web 端默认使用 backend/data/skills；桌面端使用 sidecar data_dir/skills。
# RUIJING_SKILLS_DIR=/absolute/path/to/skills  # 显式覆盖技能库根目录
# RUIJING_SERVER_DATA_DIR=/data/ai-builder      # Web 端服务数据根目录，skills 会落到其下的 skills/
# RUIJING_SKILLS_DISABLED=1                     # 显式关闭技能库写入/上传

# aPaaS 后端打包 JDK 版本：8 / 17 / auto
APAAS_BACKEND_JDK_VERSION=17

# Dolphin Code integration (used by Code mode)
# DOLPHIN_CODE_CONTROL_PLANE_URL=http://127.0.0.1:8080
# DOLPHIN_CODE_CONTROL_PLANE_TOKEN=__SET_ME__  # 可选项：仅供无用户上下文的内部任务使用
# DOLPHIN_CODE_CONTROL_PLANE_DELEGATION_SECRET=__MATCH_CONTROL_PLANE_WORKSPACE_DELEGATION_SECRET__
# DOLPHIN_CODE_BUILDER_URL=http://127.0.0.1:5173/builder/
# DOLPHIN_CODE_DEFAULT_SEED_PROJECT_ID=1781233861147
