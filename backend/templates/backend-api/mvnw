#!/bin/sh
# Apache Maven Wrapper startup script
# Automatically downloads Maven if not present; requires Java (JDK 8+).

set -e

# ── 辅助函数（必须在使用前定义） ──────────────────────────
concat_lines() {
  if [ -f "$1" ]; then
    echo "$(tr -s '\n' ' ' < "$1")"
  fi
}

# ── 项目根目录 ────────────────────────────────────────────
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$PWD}"
export MAVEN_PROJECTBASEDIR

# ── Wrapper JAR 路径 ──────────────────────────────────────
wrapperJarPath="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"

if [ ! -f "$wrapperJarPath" ]; then
  wrapperUrl="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
  mkdir -p "$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
  if command -v wget > /dev/null 2>&1; then
    wget -q -O "$wrapperJarPath" "$wrapperUrl" || { echo "ERROR: 下载 maven-wrapper.jar 失败" >&2; exit 1; }
  elif command -v curl > /dev/null 2>&1; then
    curl -f -s -o "$wrapperJarPath" "$wrapperUrl" || { echo "ERROR: 下载 maven-wrapper.jar 失败" >&2; exit 1; }
  else
    echo "ERROR: 需要 wget 或 curl 才能下载 maven-wrapper.jar" >&2
    exit 1
  fi
fi

# ── 检查 Java ─────────────────────────────────────────────
case "${APAAS_BACKEND_JDK_VERSION:-}" in
  8|1.8|jdk8|java8)
    if [ -x "/opt/jdk8/bin/java" ]; then
      JAVA_HOME="/opt/jdk8"
    fi
    ;;
  17|jdk17|java17)
    if [ -x "/opt/jdk17/bin/java" ]; then
      JAVA_HOME="/opt/jdk17"
    fi
    ;;
esac

if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

if ! command -v "$JAVACMD" > /dev/null 2>&1; then
  echo "ERROR: 未找到 java 命令，请安装 JDK 8+ 并设置 JAVA_HOME" >&2
  exit 1
fi

# ── 读取 jvm.config（如有） ───────────────────────────────
MAVEN_OPTS="$(concat_lines "$MAVEN_PROJECTBASEDIR/.mvn/jvm.config") $MAVEN_OPTS"

# ── 启动 Maven Wrapper ────────────────────────────────────
# 使用系统级 ~/.m2/settings.xml 中配置的 localRepository（如 /usr/local/repository）
exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$wrapperJarPath" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
