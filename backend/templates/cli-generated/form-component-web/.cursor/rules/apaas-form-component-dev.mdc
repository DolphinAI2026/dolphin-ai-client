import EditorFormConfigMixin from '@/mixin/form-config.mixin'

const FlvPlayerSourceValidator = function() {
  return (rule, data, callback) => {
    if (data === '') {
      callback(new Error('FLV数据源不能为空'))
    } else {
      callback()
    }
  }
}
export default {
  name: 'FormCustomFlvPlayerSource',
  mixins: [EditorFormConfigMixin],
  data() {
    return {
      rules: {}
    }
  },
  computed: {
    customFlvPlayerSource: {
      get() {
        return (
          this.componentConfig && this.componentConfig.customComponentConfig.customFlvPlayerSource
        )
      },
      set(value) {
        this.componentConfig.customComponentConfig.customFlvPlayerSource = value
      }
    }
  },
  created() {
    this.rules[this.configProperty] = [this._validate(FlvPlayerSourceValidator())]
  },
  methods: {
