##### list

list组件是在应用前台列表中看到的只读组件

src/form-component/form-widget/list/form-component-rate-list.vue
```vue
<template>
    <div class="form-component-rate-list">
        <el-rate
            disabled
            :value="formValue"
            :max="max"
            :allow-half="allowHalf"
            :show-score="!showText"
            :show-text="showText"
            :texts="texts"
        />
    </div>
</template>
<script>
export default {
    inject: ["listEngine"],
    name: "FormComponentRate",
    props: ["componentConfig", "formValue", "propKey"],
    computed: {
        max() {
            let max = (
                this.componentConfig.customComponentConfig &&
                this.componentConfig.customComponentConfig.selfNum
            );
            if (!max) {
                return Math.max(this.formValue, 5);
            }
            return max;
        },
        allowHalf() {
            const { componentConfig, formValue } = this;
            if (componentConfig.customComponentConfig) {
                return componentConfig.customComponentConfig.allowHalf;
            } else {
                return Math.floor(formValue) !== formValue
            }
        },
        showText() {
            return (
                this.componentConfig.customComponentConfig &&
                this.componentConfig.customComponentConfig.showText
            ) || false
        },
        texts() {
            return (
                this.componentConfig.customComponentConfig &&
                this.componentConfig.customComponentConfig.texts
            ) || []
        }
    }
}
</script>
```

