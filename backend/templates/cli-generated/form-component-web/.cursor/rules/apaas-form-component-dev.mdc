#### 配置项组件中选择表单设计器中已有的组件

##### 配置项组件的代码示例
主要是allComponentsOptions，严格按照示例代码中的allComponentsOptions方法进行返回`this.formEngine.formDataControl.allTileFormItemList.filter(
        (item) => item.uuid !== this.componentConfig.uuid
      )` 处理示例中的过滤掉自身之外，不要增加任何其他过滤条件。可以选择到所有其他组件。
```vue
<template>
  <div class="form-config-item form-config-custom-flv-player-source">
    <div class="label-wrapper">
      <el-form-item :label="$t('数据来源')" :rules="rules[configProperty]" :prop="configProperty">
        <el-select v-model="customFlvPlayerSource" placeholder="请选择">
          <el-option
            v-for="item in allComponentsOptions()"
            :key="item.uuid"
            :label="item.label"
            :value="item.uuid"
          >
          </el-option>
        </el-select>
      </el-form-item>
    </div>
  </div>
</template>

<script>
import EditorFormConfigMixin from '@/mixin/form-config.mixin'

const FlvPlayerSourceValidator = function() {
  return (rule, data, callback) => {
    if (data === '') {
      callback(new Error('FLV数据源不能为空'))
    } else {
      callback()
    }
  }
}
export default {
  name: 'FormCustomFlvPlayerSource',
  mixins: [EditorFormConfigMixin],
  data() {
    return {
      rules: {}
    }
  },
  computed: {
    customFlvPlayerSource: {
      get() {
        return (
          this.componentConfig && this.componentConfig.customComponentConfig.customFlvPlayerSource
        )
      },
      set(value) {
        this.componentConfig.customComponentConfig.customFlvPlayerSource = value
      }
    }
  },
  created() {
    this.rules[this.configProperty] = [this._validate(FlvPlayerSourceValidator())]
  },
  methods: {
    allComponentsOptions() {
      return this.formEngine.formDataControl.allTileFormItemList.filter(
        (item) => item.uuid !== this.componentConfig.uuid
      )
    }
  }
}
</script>

<style lang="scss"></style>
