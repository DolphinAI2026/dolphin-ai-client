### web/src/form-component/form-widget/edit/form-component-xxx-edit.vue（PC）

```vue
<template>
  <div class="form-widget form-component-xxx-edit">
    <x-proxy-form-item
      :isInTable="widget.isInTable"
      :showRequired="showRequired"
      :label="widget.label"
      :validatorRules="validatorRules"
      :validateKey="validateKey"
      :validateInfo="validateInfo"
      :webFormSettings="webFormSettings"
    >
      <!-- el-* 组件，无需 import -->
      <el-input v-model="formValue" :disabled="widget.readOnly" />
    </x-proxy-form-item>
  </div>
</template>
<script>
import FormWidgetMixin from '@shared/mixin/form-widget.mixin'

export default {
  name: 'FormComponentXxxEdit',
  mixins: [FormWidgetMixin]
}
</script>
<style lang="scss">
.form-component-xxx-edit {}
</style>
```

### mobile/src/form-component/form-widget/edit/mobile-form-component-xxx-edit.vue（移动端）

```vue
<template>
  <div class="form-widget mobile-form-component-xxx-edit">
    <x-proxy-form-item
      :isInTable="widget.isInTable"
      :showRequired="showRequired"
      :label="widget.label"
      :validatorRules="validatorRules"
      :validateKey="validateKey"
      :validateInfo="validateInfo"
      :webFormSettings="webFormSettings"
    >
