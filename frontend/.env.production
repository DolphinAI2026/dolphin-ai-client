# 生产 build 时注入的 env（npm run build 默认读 .env.production）

# Vibe Coding 沙箱预览域名 — 走 nginx vibe-preview.conf 子域反代
# 拼出 https://p{hostPort}.vibe-first.cn/ 让用户访问 podman 容器
# 见 deploy/nginx/vibe-preview.conf
VITE_SANDBOX_PREVIEW_BASE=.vibe-first.cn

# Dolphin 嵌入式问题助手。留空则不加载右下角 Dolphin 浮窗。
# 需要先确认该 agent code 已在对应 Dolphin 租户发布并对当前用户可见。
VITE_DOLPHIN_AGENT_CODE=
VITE_DOLPHIN_SERVER_URL=https://dolphin-trial.definesys.cn
VITE_DOLPHIN_BUTTON_TEXT=问题助手
