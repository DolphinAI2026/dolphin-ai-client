{
  "name": "ai-builder-issue-assistant-mcp",
  "displayName": "AI Builder 问题助手 MCP",
  "transport": "streamable-http",
  "url": "https://agent.dfy.definesys.cn/api/mcp/mcp",
  "headers": {
    "Authorization": "Bearer ${MCP_API_KEY}",
    "Accept": "application/json, text/event-stream",
    "Content-Type": "application/json"
  },
  "customBody": {
    "tenant_id": "{{tenant_id}}",
    "user_id": "{{user_id}}"
  },
  "tools": [
    "record_product_issue",
    "list_product_issues",
    "get_dev_fix_policy",
    "browser_screenshot",
    "browser_snapshot",
    "list_deploy_records"
  ],
  "notes": [
    "生产/公网部署时必须配置 MCP_API_KEYS，不能裸露 MCP。",
    "右侧问题助手自动修复只允许进入 dev 分支；main 分支禁止修改。",
    "dev 环境每天 19:00 自动部署，automation id: 19-00-dev。"
  ]
}
