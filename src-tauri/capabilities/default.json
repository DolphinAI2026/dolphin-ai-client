{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "comment": "前端由 sidecar 经 http://127.0.0.1:<port>/ 提供 = 远程内容; 不配 remote 则 capability 默认只覆盖本地 app://, 所有 JS→Tauri 命令(updater/shell open/process)会被 ACL 拦。",
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/ruijing-sidecar", "sidecar": true, "args": true }]
    },
    "shell:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
