{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DolphinAI",
  "version": "0.4.1",
  "identifier": "com.definesys.dolphin-ai",
  "build": {
    "frontendDist": "../frontend/dist-desktop",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [
      "resources/agent-runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/dolphin-ai-sidecar"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "macOS": {
      "exceptionDomain": ""
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DolphinAI2026/dolphin-ai-releases/releases/latest/download/latest.json"
      ],
