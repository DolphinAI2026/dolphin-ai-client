# 排除一切跟 docker build context 无关的东西
# 减小 build context 体积 + 避免敏感文件意外打进 image

# VCS
.git
.gitignore
.github
.vscode
.idea

# Python 缓存 / 构建产物
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.tox
*.egg-info
build
dist

# 虚拟环境
**/.venv
**/venv
**/env

# Node / 前端构建产物（源码会进 build context，依赖和 dist 不进）
**/node_modules
**/dist
**/build
**/*.tsbuildinfo
admin-spa/dist
admin-spa/node_modules

# 敏感文件 — 容器内通过 k8s secret mount，不能进 image
**/.env
**/.env.*
backend/.env

# 业务数据 / 临时文件 — 通过 PVC mount，不能进 image
backend/_online_coding
backend/workspaces
backend/.pending-dev-specs
backend/static
backend/apaas_builder*.db*
backend/*.bak
backend/*.log
backend/logs

# 文档 + 测试产物
docs/
*.md
!README.md
phase-*-deploy.md
*.tsbuildinfo

# OS / 编辑器
.DS_Store
**/Thumbs.db
*.swp
*.swo

# 数据库备份等开发期一次性产物（image 里不需要）
backend/apaas_builder.db.bak-*
backend/form_config_*.json
backend/check_*.py
backend/test_*.py
backend/debug_*.py
backend/compare_*.py
backend/recreate_*.py
backend/verify_*.py
backend/final_verification.py
backend/show_*.py
backend/save_form_config.py
