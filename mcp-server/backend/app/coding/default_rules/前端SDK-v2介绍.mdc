#### df.requestWithPromise

1.  功能描述


发送网络请求

2.  调用方式

```JavaScript
df.requestWithPromise(params)
```

3.  参数


|  字段  |  类型  |  说明  |
| --- | --- | --- |
|  params  |  Object  |  请求配置  |
|      ∟ url  |  String  |  请求接口url  |
|      ∟ method  |  String  |  请求方式，可选值为"get"、"post"  |
|      ∟ params  |  Object  |  请求参数  |
|      ∟ headers  |  Object  |  请求头  |
|      ∟ timeout  |  Number  |  超时时间（毫秒）  |
|      ∟ disableSuccessMsg  |  Boolean  |  请求成功默认有成功Toast提示，此属性为true时则不提示  |
|      ∟ disableErrorMsg  |  Boolean  |  请求失败默认有失败Toast提示，此属性为true时则不提示  |

4.  示例

```JavaScript
df.requestWithPromise({
    // Interface
    url: 'xdap-app/plugin/query/list',
    // Request method
    method: 'get',
    // Parameters
    params: {
        timestamp: new Date().getTime(),
    },
    headers: {
        'xdaptimestamp': new Date().getTime(),
    },
    // Timeout
    timeout: 5000
}).asyncThen((resp) => {
    this.sdkResult = 'Call successful, returned result: ' + JSON.stringify(resp)
}, (err) => {
    // Business error, resp.code not ok
    this.sdkResult = 'Call failed, error message: ' + err.message
}).asyncErrorCatch((err) => {
    // Network error
    this.sdkResult = 'Call failed, error message: ' + err.message
})
```

#### df.uploadWithPromise

1.  功能描述


上传附件，上传的附件若要查看需要拼接租户id、token的Base64编码

2.  调用方式

```JavaScript
df.uploadWithPromise(urlConfig)
```

3.  参数


|  字段  |  类型  |  说明  |
| --- | --- | --- |
|  urlConfig  |  Object  |  请求配置  |
|      ∟ url  |  String  |  请求接口url，默认为附件上传的接口  |
|      ∟ params  |  FormData  |  图片参数  |
|      ∟ headers  |  Object  |  请求头  |
|      ∟ timeout  |  Number  |  超时时间（毫秒）  |
|      ∟ disableSuccessMsg  |  Boolean  |  请求成功默认有成功Toast提示，此属性为true时则不提示  |
|      ∟ disableErrorMsg  |  Boolean  |  请求失败默认有失败Toast提示，此属性为true时则不提示  |

4.  示例

```JavaScript
// Example uploading an image
// Base64 image to File type
// 1. Get base64 image
let dataUrl = 'data:image/png;base64,'

// 1. Convert base64 to blob
function dataURLtoBlob(dataurl) {
    var arr = dataurl.split(','),
        mime = arr[0].match(/:(.*?);/)[1],
        bstr = atob(arr[1]),
        n = bstr.length,
        u8arr = new Uint8Array(n);
    while (n--) {
        u8arr[n] = bstr.charCodeAt(n);
    }
    return new Blob([u8arr], { type: mime });
}

// 2. Convert blob to file
function blobToFile(theBlob, fileName) {
    theBlob.lastModifiedDate = new Date();  // File last modified date
    theBlob.name = fileName;               // File name
    return new File([theBlob], fileName, {type: theBlob.type, lastModified: Date.now()});
}

// Uploaded attachments need tenant ID and token Base64 encoded for viewing
function showImg(url) {
    let token = window.btoa(JSON.stringify({
        xdaptenantid: df.getStore().state.tenantModule.currentOrg.id,
        xdaptoken: df.getStore().state.authModule.token
    }))
    return url + '&token=' + token
}

let file = blobToFile(dataURLtoBlob(dataUrl), '1.jpg')
let timestamp = new Date().getTime()
let formData = new FormData()
// file is File type data, fileName is string type
formData.append('file', file, file.name)
// timestamp is timestamp
formData.append('uploadId', timestamp)

df.uploadWithPromise({
    // Parameters
    params: formData,
    headers: {
        'xdaptimestamp': new Date().getTime(),
    },
    // Timeout
    timeout: 5000
}).asyncThen((resp) => {
    console.info('Upload successful, returned result:', resp)
}, (err) => {
    console.error(err)
}).asyncErrorCatch((err) => {
    console.error(err)
})
```

