# aPaaS Platform
APAAS_BASE_URL=https://apaas-trial.definesys.cn/backend

# LLM Configuration
# 兼容保留：运行时统一走 ANTHROPIC_BASE_URL，LLM_API_BASE 不再实际参与请求
LLM_API_BASE=https://your-llm-gateway.example.com/anthropic
LLM_API_KEY=<your-llm-api-key>
LLM_MODEL=<your-model-name>
LLM_DOC_MODEL=MiniMax-M2.5
LLM_VISION_MODEL=MiniMax-M2.7
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=MiniMax-M2.7

# Database (MySQL)
DATABASE_URL=sqlite+aiosqlite:///../../backend/apaas_builder_local.db

# JWT
JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Server
HOST=0.0.0.0
PORT=8004
MCP_API_KEYS=dev-mcp-api-key-local
MCP_BRIDGE_BASE_URLS=http://127.0.0.1:8004/api/mcp/mcp

# Code Generation
# 是否为资源编码添加随机后缀（避免编码冲突）
# 开发/测试环境建议开启（true），生产环境建议关闭（false）
ENABLE_CODE_SUFFIX=false

# Web IDE (code-server)
# code-server 外部访问基础 URL，留空则禁用 Web IDE 按钮
# 示例: https://your-domain.com/ide/
CODE_SERVER_BASE_URL=
